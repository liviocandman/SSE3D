# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docs
/docs/files

# assets
public/

# python
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.env
.env.local
.env.*

# spice kernels
sse3d-api/kernels/**
!sse3d-api/kernels/.gitkeep
!sse3d-api/kernels/lsk/.gitkeep
!sse3d-api/kernels/spk/.gitkeep

# api cache
sse3d-api/.cache/

# Versioned asset recovery outputs (Basis remains tracked)
.ruff_cache/
.cache/
*.zip
*.part
public/textures/.staging-*/
public/textures/.install.lock/
!public/
public/*
!public/basis/
public/basis/*
!public/basis/basis_transcoder.js
!public/basis/basis_transcoder.wasm

# Non-secret configuration templates
!.env.local.example
!sse3d-api/.env.example
